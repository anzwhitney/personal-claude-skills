# Runtime state (auth headers, exclude-lists, lyrics cache, venv) lives
# outside this repo under ~/.local/share/ketamine-playlist/ and
# ~/.local/share/yt-music-playlist/, but ignore these here too in case
# anything ever gets created locally by mistake. protocol.json is this
# skill's own tracked config, not runtime state -- explicitly un-ignored.
venv/
*.json
!protocol.json
__pycache__/
*.pyc
